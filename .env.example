# Copy to .env.local for development, and set the same values on the host.
# Everything here is optional except the Turnstile site key: the backend
# verifies a Turnstile token on every lead and rejects any it cannot check, so
# without this the contact form cannot be submitted at all.

# Cloudflare Turnstile — Dashboard > Turnstile > your widget > Site Key.
# The matching Secret Key belongs on the backend, not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# The Project Help API. Defaults to the deployed service when unset.
# BACKEND_URL=https://project-help-backend.onrender.com

# Canonical origin, used for metadata and sitemaps.
# NEXT_PUBLIC_SITE_URL=https://projecthelpbd.com

# Analytics — all optional, each skipped when unset.
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_GSC_VERIFICATION=
